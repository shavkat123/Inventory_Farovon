<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission
        android:name="android.permission.BLUETOOTH"
        tools:ignore="CoarseFineLocation" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_CONNECT"
        tools:ignore="BluetoothPermission" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission
        android:name="android.permission.ACCESS_FINE_LOCATION"
        tools:ignore="CoarseFineLocation" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.InventoryFarovon"
        android:usesCleartextTraffic="true"
        tools:targetApi="31">
        <activity
            android:name=".ui.login.LoginActivity"
            android:exported="false" />
        <activity
            android:name=".IdentificationActivity"
            android:exported="false"
            android:theme="@style/Theme.InventoryFarovon.NoActionBar" />
        <activity
            android:name=".ReturnToWarehouseActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity"
            android:theme="@style/Theme.InventoryFarovon.NoActionBar" />
        <activity
            android:name=".ReturnListActivity"
            android:exported="false"
            android:theme="@style/Theme.InventoryFarovon.NoActionBar" />
        <activity
            android:name=".ReturnDetailActivity"
            android:exported="false"
            android:theme="@style/Theme.InventoryFarovon.NoActionBar" />
        <activity
            android:name=".AssetMovementActivity"
            android:exported="false"
            android:theme="@style/Theme.InventoryFarovon.NoActionBar" />
        <activity
            android:name=".AssetMovementListActivity"
            android:exported="false"
            android:theme="@style/Theme.InventoryFarovon.NoActionBar" />
        <activity
            android:name=".AssetMovementDetailActivity"
            android:exported="false"
            android:theme="@style/Theme.InventoryFarovon.NoActionBar" />
        <activity
            android:name=".MolMovementActivity"
            android:exported="false"
            android:theme="@style/Theme.InventoryFarovon.NoActionBar" />
        <activity
            android:name=".MolMovementListActivity"
            android:exported="false"
            android:theme="@style/Theme.InventoryFarovon.NoActionBar" />
        <activity
            android:name=".MolMovementDetailActivity"
            android:exported="false"
            android:theme="@style/Theme.InventoryFarovon.NoActionBar" />
        <activity
            android:name=".IssueFromWarehouseActivity"
            android:exported="false"
            android:theme="@style/Theme.InventoryFarovon.NoActionBar"
            android:windowSoftInputMode="adjustPan" />
        <activity
            android:name=".PrimaryInventoryDetailActivity"
            android:exported="false"
            android:theme="@style/Theme.InventoryFarovon.NoActionBar" />
        <activity
            android:name=".IssueListActivity"
            android:exported="false"
            android:theme="@style/Theme.InventoryFarovon.NoActionBar" />
        <activity
            android:name=".IssueDetailActivity"
            android:exported="false"
            android:theme="@style/Theme.InventoryFarovon.NoActionBar" />
        <activity
            android:name=".IssueDocumentListActivity"
            android:exported="false"
            android:theme="@style/Theme.InventoryFarovon.NoActionBar" />
        <activity
            android:name=".RfidActivity"
            android:exported="false"
            android:theme="@style/Theme.InventoryFarovon" />
        <activity
            android:name=".NomenclatureActivity"
            android:exported="false" />
        <activity
            android:name=".LauncherActivity"
            android:exported="true"
            android:theme="@style/Theme.AppCompat.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:label="@string/app_name"
            android:theme="@style/Theme.InventoryFarovon.NoActionBar" />
        <activity
            android:name=".OrganizationInventoryActivity"
            android:exported="false"
            android:theme="@style/Theme.InventoryFarovon.NoActionBar" />
        <activity
            android:name=".InventoryListActivity"
            android:exported="false"
            android:theme="@style/Theme.InventoryFarovon.NoActionBar" />
        <activity
            android:name=".ScanningActivity"
            android:parentActivityName=".InventoryListActivity"
            android:exported="false"
            android:theme="@style/Theme.InventoryFarovon.NoActionBar" />


        <receiver
            android:name=".NetworkChangeReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.net.conn.CONNECTIVITY_CHANGE" />
            </intent-filter>
        </receiver>

        <activity
            android:name=".CameraScanActivity"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.AppCompat.NoActionBar" />

        <activity
            android:name=".WriteOffListActivity"
            android:exported="false"
            android:theme="@style/Theme.InventoryFarovon.NoActionBar" />
        <activity
            android:name=".WriteOffActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.InventoryFarovon.NoActionBar"
            android:windowSoftInputMode="adjustPan" />
        <activity
            android:name=".WriteOffDetailActivity"
            android:exported="false"
            android:theme="@style/Theme.InventoryFarovon.NoActionBar" />
        <activity
            android:name=".PrimaryInventoryListActivity"
            android:exported="false"
            android:theme="@style/Theme.InventoryFarovon.NoActionBar" />
        <activity
            android:name=".PrimaryInventoryCreateActivity"
            android:exported="false"
            android:theme="@style/Theme.InventoryFarovon.NoActionBar"
            android:windowSoftInputMode="adjustPan" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="com.inventory.farovon.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>