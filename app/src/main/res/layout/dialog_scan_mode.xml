<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/dialog_background_rounded"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Режим считывания"
        android:textSize="20sp"
        android:textColor="@android:color/black"
        android:textStyle="bold"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"/>

    <com.google.android.material.button.MaterialButtonToggleGroup
        android:id="@+id/toggle_group_scan_mode"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:singleSelection="true"
        app:selectionRequired="true"
        android:layout_marginBottom="16dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_rfid"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="RFID"
            app:backgroundTint="@color/toggle_button_background_color"
            android:textColor="@color/toggle_button_text_color" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_barcode"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="ШК"
            app:backgroundTint="@color/toggle_button_background_color"
            android:textColor="@color/toggle_button_text_color" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_sn"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="SN"
            app:backgroundTint="@color/toggle_button_background_color"
            android:textColor="@color/toggle_button_text_color" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_camera"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="КАМЕРА"
            app:backgroundTint="@color/toggle_button_background_color"
            android:textColor="@color/toggle_button_text_color" />

    </com.google.android.material.button.MaterialButtonToggleGroup>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/btn_scanner_settings"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:src="@drawable/ic_scan"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Настройки сканера"
            app:tint="@color/colorPrimary" />

        <Button
            android:id="@+id/btn_manual_input"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="РУЧНОЙ ВВОД"
            android:enabled="false" />

    </LinearLayout>

</LinearLayout>
